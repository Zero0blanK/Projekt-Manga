# Copy to .env and fill in real values. Never commit .env.

# The one place the database is described. Read by the Prisma CLI (generate/migrate/
# studio, via prisma.config.ts) *and* by the running server (src/configs/env.ts, which
# hands it to the libSQL driver adapter).
#
# SQLite: one file, no database server to install, run or back up. A relative path
# resolves against the server's working directory (apps/server). The desktop installer
# overrides this with an absolute path inside the user's app-data directory, so the
# database survives app updates and lives somewhere writable.
#
# Migrating from the old MariaDB setup: export with
#   node scripts/export-mariadb-snapshot.mjs snapshot.json     (with the old mysql:// URL)
# then, after switching this to a file: URL and running `prisma migrate deploy`,
#   node scripts/import-sqlite-snapshot.mjs snapshot.json
DATABASE_URL="file:./data/projektmanga.db"

# Server
SERVER_PORT=4000
# Interface to bind on. Unset means every interface, which is what a hosted deployment
# wants. The desktop installer sets 127.0.0.1: there the API is reached only through the
# web app's rewrite proxy, so a LAN-visible port would be surface with no purpose.
# SERVER_HOST=127.0.0.1
# Pending schema migrations are applied at startup by default, behind a backup that is
# restored if they fail (src/configs/migrate.ts). When nothing is pending, startup only
# reads the migration ledger. Set to 0 only if you apply migrations yourself (for example
# with `npm run db:deploy` in a deployment pipeline).
# PROJEKT_MANGA_AUTO_MIGRATE=0
NODE_ENV=development
# Must be the exact origin apps/web is served from — CORS only accepts this one origin
# (see app.ts), and it must share a *registrable domain* with wherever this server itself
# is reached from a browser: the session cookie is set SameSite=Lax, which browsers only
# send on same-site requests. localhost:3000 + localhost:4000 count as same-site despite
# the different ports, so this default works out of the box — but if you ever host the
# web app and this API on genuinely different domains (a common self-hosting split:
# static web hosting for the frontend, your own box for the API), login will silently
# stop working with no error surfaced anywhere, because the browser just drops the cookie
# on every cross-site request. Put both behind one reverse-proxy origin instead, or you'll
# need to revisit the cookie's SameSite/Secure settings in auth.controller.ts.
CLIENT_URL=http://localhost:3000

# How much of X-Forwarded-For to believe. Unset means "loopback", which is correct for the
# desktop installer (the API is reached only through the web server's proxy on 127.0.0.1)
# and for anything exposed directly.
#
# This is a security setting, not a cosmetic one: it decides req.ip, and req.ip is the key
# the login/register rate limiter counts against. Trusting the header when nothing upstream
# overwrites it lets a caller present a new address on every request, so the limiter never
# trips and password guesses become unmetered.
#
# Set it to the NUMBER OF PROXIES in front of this server — 1 behind a single nginx, 2
# behind Cloudflare in front of nginx. `false` disables it; an IP, CIDR or comma-separated
# list also works.
# TRUST_PROXY=1

# Host-level routes (download folder, extension install/remove, backup restore) are open
# to every client by default, so any browser that can reach this server can manage it.
# Setting a token (16+ chars) restricts them to loopback clients plus requests sending it
# as the X-Admin-Token header. The web app does not send that header, so once this is set
# those screens only work from a browser on the server machine (or the desktop app).
# ADMIN_TOKEN=

# Extension repository signature pinning (opt-in, per repository URL).
#
# A JSON object mapping an exact repository URL to the Ed25519 public keys its maintainer
# signs listings with:
#   EXTENSION_REPOSITORY_TRUST_KEYS='{"https://example.com/repo.json":[{"key_id":"2026-a","public_key":"<base64 DER SPKI>"}]}'
#
# Unset (the default, `{}`) every repository is unpinned: a bundle still has to match the
# sha256 and size its own listing declares, but nothing proves who published that listing.
# Once a URL appears here, an install or update from it is refused unless the listing
# carries a valid signature from one of these keys — which is what makes a compromised
# repository unable to push code to an already-installed source. Only public keys belong
# here; the server never accepts a private key. Removing a key_id revokes it.
#
# Invalid JSON, a non-Ed25519 key or a duplicate key_id aborts startup rather than
# silently falling back to "unpinned".
# EXTENSION_REPOSITORY_TRUST_KEYS={}

# Downloads
# DOWNLOAD_DIR=

# Repo-installed extensions (dynamic-extension-repositories.md): where downloaded source
# bundles are stored, one subdirectory per installed_extension row. Server-internal
# runtime state, not user-facing content, so this defaults under the app's own working
# directory rather than the user's Downloads folder.
# EXTENSION_BUNDLES_DIR=

# Image proxy / scraper user-agent
# USER_AGENT_SOURCE_URL also feeds apps/extensions' UserAgentManager rotation pool
# (it runs in-process with the server) — one configured source keeps both the
# image-proxy UA and the scraper's UA pool current. Accepts plain text, a JSON
# object with a userAgent-like field, or a JSON list of UA strings (an entry is
# picked at random) — e.g. https://microlink.io/user-agents.json's `user: string[]`.
USER_AGENT_SOURCE_URL=https://microlink.io/user-agents.json
# IMAGE_PROXY_USER_AGENT_SOURCE_URL=
# IMAGE_PROXY_USER_AGENT=
USER_AGENT_REFRESH_INTERVAL_MS=3600000

# apps/extensions anti-detection: proxy pool (comma-separated, e.g.
# "http://user:pass@host:1234,socks5://host:1080"). Empty/unset means direct
# connections only — proxy rotation strategies have nothing to rotate through.
# EXT_PROXY_LIST=
EXT_PROXY_ROTATION_STRATEGY=round-robin
EXT_PROXY_FAILURE_THRESHOLD=3
EXT_PROXY_COOLDOWN_MS=300000

# apps/extensions per-source overrides (apps/extensions/config/source.config.ts).
# <NAME> is the source id uppercased: ASURASCANS, KISSMANGA, MANGADEX, MANGAKAKALOT,
# MANGAGEKO, MANGATX, NHENTAI. All optional — each falls back to a source-specific
# default already tuned per site, so only set one if you need to override it.
# EXT_SOURCE_<NAME>_BASE_URL=            # e.g. EXT_SOURCE_KISSMANGA_BASE_URL=https://kissmanga.in
# EXT_SOURCE_<NAME>_RATE_LIMIT_MS=       # minimum ms between requests to that source
# EXT_SOURCE_<NAME>_CACHE_TTL_MS=        # how long a scraped page/response stays cached

# apps/extensions: shared timeout for a single Playwright/Puppeteer fallback fetch
# attempt (utils/scraper.ts), and the source circuit breaker's trip threshold/cooldown
# (features/SourceCircuitBreaker.ts) — opens after this many consecutive failures for a
# source and fails fast for this long before allowing a retry.
# EXT_BROWSER_FALLBACK_TIMEOUT_MS=30000
# EXT_BREAKER_FAILURE_THRESHOLD=5
# EXT_BREAKER_COOLDOWN_MS=120000

# Third-party tracker syncing (tracker-syncing.md). Register a client at
# anilist.co/settings/developer — redirect URI must exactly match ANILIST_REDIRECT_URI
# below. Leave all three unset and tracker sync is simply unreachable (GET /authorize
# and the callback both fail closed rather than silently no-op).
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4000/api/trackers/anilist/callback

# MyAnimeList requires MAL to approve your API application first (no self-serve client
# registration like AniList) — see myanimelist.net/apiconfig. Its auth flow also needs
# PKCE (handled automatically by tracker.service.ts/mal.tracker.ts, no extra config
# here). MAL_CLIENT_SECRET is optional — MAL supports public (PKCE-only) clients too.
# MAL_CLIENT_ID=
# MAL_CLIENT_SECRET=
# MAL_REDIRECT_URI=http://localhost:4000/api/trackers/myanimelist/callback

# How often the background job checks for progress/status changed directly on a
# tracker's own site/app (not through this one) — see tracker.service.ts's
# pollExternalChanges. Only starts once at least one tracker's *_CLIENT_ID is set.
# TRACKER_POLL_INTERVAL_MS=1800000

# How many links one poll cycle will sync, and how long it waits between them. Both
# trackers rate-limit per minute, so a cycle is capped and paced rather than firing at
# every link at once. Links are taken least-recently-synced first, so raising the cap
# only makes a full pass finish sooner — nothing is ever skipped permanently. Raise the
# cap (or lower the spacing) only if a large library isn't keeping up.
# TRACKER_MAX_LINKS_PER_CYCLE=20
# TRACKER_LINK_SPACING_MS=1500

# Encrypts tracker_account.access_token/refresh_token at rest — a 32-byte key,
# base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before any tracker account can be connected; losing it makes every
# already-connected account's stored tokens permanently undecryptable.
# TOKEN_ENCRYPTION_KEY=

# Refuse to start a chapter download when less than this much disk space is left. Fails
# once with a clear message instead of every page failing its write against a full disk.
# DOWNLOAD_MIN_FREE_BYTES=524288000
