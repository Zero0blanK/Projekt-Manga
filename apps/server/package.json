{
  "name": "@projekt-manga/server",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:deps && prisma generate",
    "dev": "tsx watch src/server.ts",
    "build:deps": "npm run build --workspace=@projekt-manga/types && npm run build --workspace=@projekt-manga/schemas && npm run build --workspace=@projekt-manga/extensions",
    "build": "npm run build:deps && prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run build:deps",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify:extensions": "tsx scripts/verify-extensions.ts"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@projekt-manga/extensions": "*",
    "@projekt-manga/schemas": "*",
    "@projekt-manga/types": "*",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "mariadb": "^3.5.3",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.32.0",
    "prettier": "^3.7.3",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
