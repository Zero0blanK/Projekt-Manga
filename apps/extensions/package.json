{
  "name": "@projekt-manga/extensions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "_exportsNote": "./sandbox is a separate entry point on purpose. The root entry re-exports the anti-detection stack, which pulls in puppeteer and playwright at import time; the sandbox needs neither, and a sandboxed source cannot use them anyway (its child has no --allow-child-process and no network of its own). Importing the sandbox through this subpath is what lets the desktop installer ship without a browser stack it could never drive.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@projekt-manga/types": "*",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "https-proxy-agent": "^7.0.6",
    "playwright": "^1.55.0",
    "puppeteer": "^25.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "prettier": "^3.7.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
