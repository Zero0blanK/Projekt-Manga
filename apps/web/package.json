{
  "name": "ProjektManga",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace=@projekt-manga/types && npm run build --workspace=@projekt-manga/schemas && npm run build --workspace=@projekt-manga/api-client && node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "prebuild": "npm run build --workspace=@projekt-manga/types && npm run build --workspace=@projekt-manga/schemas && npm run build --workspace=@projekt-manga/api-client && node scripts/copy-ocr-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "pretypecheck": "npm run build:shared --prefix ../..",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:shared --prefix ../..",
    "test": "vitest run",
    "test:watch": "vitest"
  },
