; Projekt Manga installer additions, included by electron-builder (nsis.include).

; Show the progress details open instead of behind a "Show details" button.
ShowInstDetails show

; Defining customCheckAppRunning replaces electron-builder's default "is the app running"
; check, so its prerequisites are declared here as the template would have, and the default
; check is still run first.
!include "getProcessInfo.nsh"
Var pid

!macro customCheckAppRunning
  !insertmacro IS_POWERSHELL_AVAILABLE
  !insertmacro _CHECK_APP_RUNNING
  ; Extraction happens right after this check. Swap in the version that lists each file
  ; (generated by scripts/prepare-installer-script.mjs).
  ; The uninstaller runs the same check but extracts nothing, and the swap happens only once.
  !ifmacrodef extractUsing7za
    !ifndef PM_DETAILED_EXTRACT
      !define PM_DETAILED_EXTRACT
      !macroundef extractUsing7za
      !include "${BUILD_RESOURCES_DIR}\nsis\extractUsing7za.nsh"
    !endif
  !endif
!macroend

; Reopen the app after an update, by its own path.
;
; An in-app update runs this installer silently with --force-run, and electron-builder's
; template then starts the app through StdUtils.ExecShellAsUser on the Start menu shortcut
; with "--updated" added. Opened that way, with an argument, the app may not start at all
; (electron-builder issue #5988), and the update then installs but leaves nothing running.
; So, as VS Code's installer does, the app is also started straight from its executable.
; If the template's start works too, the second start only reaches the app's single-instance
; lock and hands over to the window already open. Per-user installs only: a per-machine one
; runs elevated here, and Exec would start the app as administrator.
!macro customInstall
  ${if} ${Silent}
  ${andIf} ${isForceRun}
  ${andIf} $installMode == "CurrentUser"
    Exec '"$appExe" --updated'
  ${endIf}
!macroend
