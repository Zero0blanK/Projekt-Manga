; Projekt Manga installer additions, included by electron-builder (nsis.include).

; Show the progress details open instead of behind a "Show details" button.
ShowInstDetails show

; Defining customCheckAppRunning replaces electron-builder's default "is the app running"
; check, so its prerequisites are declared here as the template would have, and the default
; check is still run first.
!include "getProcessInfo.nsh"
Var pid

!macro customCheckAppRunning
  !insertmacro _CHECK_APP_RUNNING
  ; Extraction happens right after this check. Swap in the version that lists each file
  ; (generated by scripts/prepare-installer-script.mjs).
  ; The uninstaller runs the same check but extracts nothing, and the swap happens only once.
  !ifmacrodef extractUsing7za
    !ifndef PM_DETAILED_EXTRACT
      !define PM_DETAILED_EXTRACT
      !macroundef extractUsing7za
      !include "${BUILD_RESOURCES_DIR}\nsis\extractUsing7za.nsh"
    !endif
  !endif
!macroend
