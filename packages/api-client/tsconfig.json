{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": "src",
    "outDir": "dist",

    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "declaration": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
