# ============================================================
# Extensions anti-detection runtime state
# ============================================================

# Session/fingerprint cache the scraper stack persists between runs — regenerated
# automatically, not something to ship or diff.
apps/extensions/data/sessions/*.json

# Downloaded repo-installed extension bundles (dynamic-extension-repositories.md) —
# fetched at install/update time from a repository URL, not something to ship or diff.
# The SQLite database and its WAL/shm sidecars — this is the user's actual library and
# reading history, and it is a build artefact of `prisma migrate`, not source.
apps/server/data/*.db
apps/server/data/*.db-wal
apps/server/data/*.db-shm
# Backups the startup migration takes before applying a schema change.
apps/server/data/*.bak
apps/server/data/*.bak-wal
apps/server/data/*.bak-shm
apps/server/data/*.failed-*
# One-off MariaDB export produced by scripts/export-mariadb-snapshot.mjs. Same data, same
# reason to keep it out of the repo.
apps/server/mariadb-snapshot.json
*-snapshot.json

# Installer staging tree — a build artefact of apps/desktop/scripts/stage-installer.mjs,
# containing full production node_modules trees for the server and web app.
apps/desktop/staging/
apps/desktop/staging-*/
apps/desktop/release-plan-validation/

# Downloaded Node runtime shipped with the installer (see scripts/stage-node-runtime.mjs).
# Kept outside staging/ so it survives that tree being cleared on every build.
apps/desktop/.node-runtime-cache/

apps/server/data/

# ============================================================
# Documentation
# ============================================================
**/API.md
# Generated by apps/desktop/scripts/prepare-installer-script.mjs
apps/desktop/build/nsis/
